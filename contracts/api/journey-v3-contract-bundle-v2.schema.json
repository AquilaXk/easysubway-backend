{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.example/contracts/api/journey-v3-contract-bundle-v2.schema.json",
  "title": "Journey V3 contract bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleVersion",
    "component",
    "producerRepository",
    "producerSha",
    "resources"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "bundleVersion": { "const": "2.0.0" },
    "component": { "const": "backend" },
    "producerRepository": { "const": "AquilaXk/easysubway-backend" },
    "producerSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "resources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/resource" },
            {
              "properties": {
                "id": { "const": "journey-v3-error-catalog" },
                "path": { "const": "contracts/api/journey-v3-error-catalog.json" },
                "mediaType": { "const": "application/json" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/resource" },
            {
              "properties": {
                "id": { "const": "journey-v3-error-disposition" },
                "path": { "const": "contracts/api/journey-v3-error-disposition.json" },
                "mediaType": { "const": "application/json" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/resource" },
            {
              "properties": {
                "id": { "const": "journey-v3-openapi" },
                "path": { "const": "contracts/api/journey-v3.openapi.yaml" },
                "mediaType": { "const": "application/yaml" }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "owner", "mediaType", "sha256", "contentBase64"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "owner": { "const": "AquilaXk/easysubway-backend" },
        "mediaType": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contentBase64": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
