# ==============================================================================
# EasySubway Backend Environment Variables Template (.env.example)
# Copy to .env or export into your local environment before running.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
EASYSUBWAY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easysubway
EASYSUBWAY_DATASOURCE_USERNAME=easysubway
EASYSUBWAY_DATASOURCE_PASSWORD=easysubway_local

# Object Storage Configuration (MinIO / S3)
EASYSUBWAY_OBJECT_STORAGE_ACCESS_KEY=easysubway_local
EASYSUBWAY_OBJECT_STORAGE_SECRET_KEY=easysubway_local_secret
EASYSUBWAY_OBJECT_STORAGE_REGION=us-east-1
EASYSUBWAY_REPORT_OBJECT_STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
EASYSUBWAY_REPORT_UPLOAD_PUBLIC_BASE_URL=http://localhost:9000/reports
EASYSUBWAY_REPORT_UPLOAD_BUCKET=reports
EASYSUBWAY_REPORT_UPLOAD_MAX_BYTES=921600
EASYSUBWAY_REPORT_UPLOAD_URL_TTL_SECONDS=900

# Security & Secrets (Development Dummy Keys)
EASYSUBWAY_REPORT_UPLOAD_INTENT_SIGNING_KEY=dev-intent-signing-key-minimum-32-chars-long!
EASYSUBWAY_REPORT_RECEIPT_PEPPER=dev-report-receipt-pepper-value-12345
EASYSUBWAY_ADMIN_REMEMBER_ME_KEY=dev-admin-remember-me-key-sample-12345
EASYSUBWAY_DATAPACK_CALLBACK_HMAC_KEY=dev-callback-hmac-key-minimum-32-chars!

# Admin / Operator Credentials (Development Defaults)
EASYSUBWAY_ADMIN_USERNAME=admin
EASYSUBWAY_ADMIN_PASSWORD=adminpassword
EASYSUBWAY_OPERATOR_USERNAME=operator
EASYSUBWAY_OPERATOR_PASSWORD=operatorpassword
EASYSUBWAY_ADMIN_BASIC_AUTH_ENABLED=true

# Datapack & Journey Settings
EASYSUBWAY_DATAPACK_CATALOG_BASE_URL=http://localhost:8080
EASYSUBWAY_DEV_SEED=false
