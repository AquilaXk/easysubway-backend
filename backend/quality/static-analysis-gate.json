{
  "schemaVersion": 1,
  "gateId": "backend-static-analysis-gate",
  "defaultPolicy": "zero-finding-required-enforcement",
  "enforcementStatus": "spotbugs-zero-finding-required-enforced",
  "ciRuntimeBudgetMinutes": {
    "maxAdditionalMinutes": 3,
    "measurementRequiredBeforeEnforcement": true
  },
  "tools": [
    {
      "id": "checkstyle",
      "enforcement": "not_enabled_in_this_slice",
      "firstAllowedGate": "style_baseline_after_contract_comments",
      "requires": [
        "documented rule set",
        "baseline violation count",
        "CI runtime measurement"
      ]
    },
    {
      "id": "spotbugs",
      "enforcement": "required_fail_closed_zero_finding",
      "firstAllowedGate": "backend-spotbugs-main",
      "evidence": {
        "suppressionPolicy": "backend/quality/spotbugs-suppression-policy.json",
        "excludeFilter": "backend/quality/spotbugs-exclude.xml",
        "requiredValidator": "tools/ci/backend-spotbugs-gate.mjs",
        "resultArtifact": "backend-spotbugs-${GITHUB_SHA}/backend-spotbugs-result.json",
        "failMode": "spotbugsMain ignoreFailures=false and the closed validator requires ENFORCED policy, zero current findings, and the immutable 195-entry terminal ledger; spotbugsTest remains non-failing under NOT_REQUIRED_CURRENT",
        "foundationIssue": "https://github.com/AquilaXk/easysubway-backend/issues/35",
        "remediationOwnerIssue": "https://github.com/AquilaXk/easysubway-backend/issues/4"
      },
      "requires": [
        "closed finding-policy validator",
        "current XML/HTML/result artifact",
        "exact 195-entry immutable identity-order ledger with no missing, extra, duplicate, stale, expired, wildcard, suppression mismatch, or owner mismatch",
        "terminal dispositions absent from the report and exact method suppression matches only"
      ]
    },
    {
      "id": "errorprone",
      "enforcement": "not_enabled_in_this_slice",
      "firstAllowedGate": "compiler_plugin_baseline_after_gradle_cost_check",
      "requires": [
        "Java 21 compatibility check",
        "Gradle cache impact measurement",
        "CI runtime measurement"
      ]
    },
    {
      "id": "archunit",
      "enforcement": "enabled",
      "firstAllowedGate": "public_mobile_api_absence",
      "evidence": {
        "hexagonalBoundaryInventory": "jdeps snapshot in PR evidence",
        "publicMobileApiAbsenceContract": "repository-contract test: 백엔드는 모바일 기본 경로용 public transit, me API와 search 외 route API를 노출하지 않는다",
        "ciRuntimeMeasurement": "./gradlew test --tests '*PackageDependencyRulesTest' measured locally under 3 minutes"
      },
      "requires": [
        "current hexagonal boundary inventory",
        "public mobile API absence contract",
        "CI runtime measurement"
      ]
    },
    {
      "id": "jacoco",
      "enforcement": "required_fail_closed_decrease_only",
      "firstAllowedGate": "backend-critical-coverage",
      "evidence": {
        "coveragePolicy": "backend/quality/jacoco-coverage-policy.json",
        "coverageBaseline": "backend/quality/jacoco-coverage-baseline.json",
        "coverageExclusionPolicy": "backend/quality/jacoco-exclusion-policy.json",
        "requiredValidator": "tools/ci/backend-coverage-gate.mjs",
        "resultArtifact": "backend-critical-coverage-${GITHUB_SHA}/backend-critical-coverage-result.json",
        "failMode": "Phase B revalidates current evidence and requires decrease-only PASS; no Gradle global percentage gate",
        "globalPercentFailGate": false
      },
      "requires": [
        "reviewed current critical source inventory",
        "exact JaCoCo XML and source identity",
        "decrease-only line and branch evidence"
      ]
    }
  ],
  "mustNotDo": [
    "enable_style_or_coverage_plugins_without_runtime_budget_evidence",
    "reformat_unrelated_backend_sources",
    "weaken_security_route_or_release_contract_tests"
  ]
}
