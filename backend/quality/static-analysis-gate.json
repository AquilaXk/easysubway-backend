{
  "schemaVersion": 1,
  "gateId": "backend-static-analysis-gate",
  "defaultPolicy": "closed-report-policy-before-final-enforcement",
  "enforcementStatus": "spotbugs-discovery-remote-red",
  "ciRuntimeBudgetMinutes": {
    "maxAdditionalMinutes": 3,
    "measurementRequiredBeforeEnforcement": true
  },
  "tools": [
    {
      "id": "checkstyle",
      "enforcement": "not_enabled_in_this_slice",
      "firstAllowedGate": "style_baseline_after_contract_comments",
      "requires": [
        "documented rule set",
        "baseline violation count",
        "CI runtime measurement"
      ]
    },
    {
      "id": "spotbugs",
      "enforcement": "required_fail_closed_discovery",
      "firstAllowedGate": "backend-spotbugs-main",
      "evidence": {
        "suppressionPolicy": "backend/quality/spotbugs-suppression-policy.json",
        "excludeFilter": "backend/quality/spotbugs-exclude.xml",
        "requiredValidator": "tools/ci/backend-spotbugs-gate.mjs",
        "resultArtifact": "backend-spotbugs-${GITHUB_SHA}/backend-spotbugs-result.json",
        "failMode": "ignoreFailures=true only while the closed validator produces the required discovery RED artifact",
        "foundationIssue": "https://github.com/AquilaXk/easysubway-backend/issues/35"
      },
      "requires": [
        "closed finding-policy validator",
        "current XML/HTML/result artifact",
        "root-reviewed exact FIX_REQUIRED inventory before phase-two PASS"
      ]
    },
    {
      "id": "errorprone",
      "enforcement": "not_enabled_in_this_slice",
      "firstAllowedGate": "compiler_plugin_baseline_after_gradle_cost_check",
      "requires": [
        "Java 21 compatibility check",
        "Gradle cache impact measurement",
        "CI runtime measurement"
      ]
    },
    {
      "id": "archunit",
      "enforcement": "enabled",
      "firstAllowedGate": "public_mobile_api_absence",
      "evidence": {
        "hexagonalBoundaryInventory": "jdeps snapshot in PR evidence",
        "publicMobileApiAbsenceContract": "repository-contract test: 백엔드는 모바일 기본 경로용 public transit, me API와 search 외 route API를 노출하지 않는다",
        "ciRuntimeMeasurement": "./gradlew test --tests '*PackageDependencyRulesTest' measured locally under 3 minutes"
      },
      "requires": [
        "current hexagonal boundary inventory",
        "public mobile API absence contract",
        "CI runtime measurement"
      ]
    },
    {
      "id": "jacoco",
      "enforcement": "report_only",
      "firstAllowedGate": "coverage_baseline_after_p0_tests_stabilize",
      "evidence": {
        "coverageExclusionPolicy": "backend/quality/jacoco-exclusion-policy.json",
        "failMode": "no jacocoTestCoverageVerification / no global % fail",
        "reportPaths": "backend/build/reports/jacoco/test/jacocoTestReport.xml",
        "ciRuntimeMeasurement": "local 2026-07-22: ./gradlew test --tests '*PackageDependencyRulesTest' jacocoTestReport --no-daemon real 24.19s; report-only no % fail"
      },
      "requires": [
        "P0 security and route test baseline",
        "coverage exclusion policy",
        "CI runtime measurement"
      ]
    }
  ],
  "mustNotDo": [
    "enable_style_or_coverage_plugins_without_runtime_budget_evidence",
    "reformat_unrelated_backend_sources",
    "weaken_security_route_or_release_contract_tests"
  ]
}
